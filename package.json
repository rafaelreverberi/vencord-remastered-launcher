{
  "name": "vencord-remastered-launcher",
  "productName": "Vencord Remastered Launcher",
  "version": "0.1.1",
  "description": "Persistent plugin, build and patch manager for Vencord Remastered",
  "author": "rafaelreverberi",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/rafaelreverberi/vencord-remastered-launcher",
  "main": "app/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir",
    "test:integration": "node scripts/integration.cjs",
    "test:ui": "node scripts/ui-test.cjs"
  },
  "dependencies": {
    "dugite": "3.2.3",
    "electron-updater": "6.8.3",
    "semver": "7.7.4",
    "tar": "7.5.13"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.59.1"
  },
  "build": {
    "appId": "io.github.rafaelreverberi.vencord-remastered",
    "asar": true,
    "files": [
      "app/**/*",
      "LICENSE",
      "NOTICE",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/dugite/git/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "Vencord Remastered",
        "schemes": [
          "vencord-remastered"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSAppBundlesUsageDescription": "Vencord Remastered Launcher needs to modify Discord’s application bundle to install and repair your locally built Vencord Remastered patch."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "rafaelreverberi <155100918+rafaelreverberi@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "rafaelreverberi",
      "repo": "vencord-remastered-launcher"
    },
    "icon": "build/icon.png"
  },
  "desktopName": "vencord-remastered-launcher"
}
